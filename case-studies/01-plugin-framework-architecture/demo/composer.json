{
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "symfony/framework-bundle": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/yaml": "^8.0",
    "symfony/string": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "dev:api": "php -S 127.0.0.1:${API_PORT:-8000} -t public",
    "lint:php": "php -l public/index.php && find src -name '*.php' -print -exec php -l {} \\;"
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  }
}
